---
import '../styles/global.css';
import '../styles/brand.css';
import Icon from '../components/Icon.astro';
import { site, url, absolute, navigation } from '../data/site.mjs';
const { title, description, path = '', article = false } = Astro.props;
const canonical = absolute(path);
const structured = { '@context': 'https://schema.org', '@type': article ? 'Article' : 'WebPage', name: title, description, url: canonical, inLanguage: 'en-IN', ...(article ? { publisher: { '@type': 'Organization', name: 'ValariFlow' } } : {}) };
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} | ValariFlow</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/><link rel="icon" href={url('valariflow-logo.jpeg')} type="image/jpeg"/>
  <meta name="theme-color" content="#0B1220"/>
  {(!site.publicationApproved || path === '404/') && <meta name="robots" content="noindex, nofollow"/>}
  <meta property="og:site_name" content="ValariFlow"/><meta property="og:type" content={article ? 'article' : 'website'}/>
  <meta property="og:title" content={`${title} | ValariFlow`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content={absolute('valariflow-logo.jpeg')}/><meta property="og:image:width" content="1408"/><meta property="og:image:height" content="768"/><meta property="og:image:alt" content="ValariFlow — Precision conversation automation"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}/>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {site.reviewDeploymentApproved && !site.publicationApproved && <aside class="review-banner" aria-label="Website review status"><div class="container">Website preview for review · Product availability and legal pages remain under review. <a href={url('contact-sales/')}>Share your feedback</a></div></aside>}
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand brand-image" href={url()} aria-label="ValariFlow home"><img src={url('valariflow-logo.jpeg')} width="1408" height="768" alt="ValariFlow — Precision conversation automation" fetchpriority="high"/></a>
      <nav class="desktop-nav" aria-label="Main navigation">{navigation.map(([label, href]) => <a href={url(href)} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</nav>
      <a class="button button-small header-cta" href={url('request-demo/')} data-conversion="header-demo">Request a demo <Icon size={16}/></a>
      <details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation">{[...navigation, ['About', 'about/'], ['Blog', 'blog/'], ['Contact sales', 'contact-sales/'], ['Request a demo', 'request-demo/']].map(([label, href]) => <a href={url(href)} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</nav></details>
    </div>
  </header>
  <main id="main"><slot/></main>
  <footer class="site-footer"><div class="container"><div class="footer-top"><div class="footer-brand"><a class="brand brand-image" href={url()}><img src={url('valariflow-logo.jpeg')} width="1408" height="768" alt="ValariFlow" loading="lazy"/></a><p>A clearer way to manage<br/>business conversations.</p><a class="email-link" href={`mailto:${site.email}`}>{site.email}</a></div><div><h2>Product</h2>{navigation.map(([label, href]) => <a href={url(href)}>{label}</a>)}</div><div><h2>Company</h2>{[['About us','about/'],['Blog & guides','blog/'],['Request a demo','request-demo/'],['Contact sales','contact-sales/']].map(([label, href]) => <a href={url(href)}>{label}</a>)}</div><div><h2>Legal</h2>{[['Privacy policy','privacy-policy/'],['Terms of service','terms-of-service/'],['Data deletion','data-deletion/']].map(([label, href]) => <a href={url(href)}>{label}</a>)}</div></div><div class="footer-bottom"><p>© {new Date().getFullYear()} ValariFlow.</p><p>Independent product. No Meta partnership or approval claimed.</p></div></div></footer>
</body>
</html>
