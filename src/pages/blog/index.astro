---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { posts } from '../../data/posts.mjs';
import { url } from '../../data/site.mjs';
---
<Layout title="Practical guides for clearer business conversations" description="Simple guides to customer conversation context, messaging permission and campaign previews for small business teams." path="blog/">
<PageHero eyebrow="The ValariFlow journal" title="A little clarity for the everyday." text="Practical ideas for business conversations, thoughtful workflows and the team behind the next reply."/>
<section class="section"><div class="container blog-grid">{posts.map(p=><article class="blog-card"><div class="blog-cover" aria-hidden="true"><Icon name={p.icon} size={48}/></div><div class="blog-card-content"><span class="blog-meta">{p.category} · {p.minutes}</span><h2><a href={url(`blog/${p.slug}/`)}>{p.title}</a></h2><p>{p.description}</p><a class="text-link" href={url(`blog/${p.slug}/`)}>Read the guide <Icon size={16}/></a></div></article>)}</div></section><CTA source="blog"/>
</Layout>
