---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import { posts } from '../../data/posts.mjs';
import { url } from '../../data/site.mjs';
export function getStaticPaths() { return posts.map(post => ({ params:{slug:post.slug}, props:{post} })); }
const { post } = Astro.props;
---
<Layout title={post.title} description={post.description} path={`blog/${post.slug}/`} article>
<PageHero eyebrow={`${post.category} · ${post.minutes}`} title={post.title} text={post.description}/>
<section class="section"><article class="container article-wrap prose"><p>By ValariFlow · Product education</p>{post.sections.map(([title,text])=><section><h2>{title}</h2><p>{text}</p></section>)}<p><a href={url('blog/')}>← Back to all guides</a></p></article></section><CTA source={`blog-${post.slug}`}/>
</Layout>
