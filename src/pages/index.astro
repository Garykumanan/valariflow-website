---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductPreview from '../components/ProductPreview.astro';
import CTA from '../components/CTA.astro';
import { url, features, faqs } from '../data/site.mjs';
---
<Layout title="Business messaging, with a little more flow" description="Explore ValariFlow: contact management, business conversations and guided workflow tools for Indian SMBs. Request a demo to see what fits your business.">
<section class="hero"><div class="container"><div class="hero-layout"><div class="hero-copy"><span class="hero-tag"><span class="tiny-dot"></span> Built around the way small businesses work</span><h1>More conversation.<br/>Less chaos.<br/><em>That’s your flow.</em></h1><p class="lead">Bring your contacts, customer conversations and team workflows into a clearer workspace. Make room for the business you’re building.</p><div class="hero-actions"><a class="button" href={url('request-demo/')} data-conversion="home-hero-demo">Request a demo <Icon size={17}/></a><a class="button button-outline" href={url('how-it-works/')}>See how it works <span aria-hidden="true">↗</span></a></div><p class="hero-footnote"><Icon name="check" size={15}/> Explore the product. No payment on this website.</p></div><ProductPreview/></div><div class="hero-channels"><p>Designed for your business conversations on</p><div class="channel-list"><span class="channel-name"><span class="channel-symbol" aria-hidden="true">◉</span> WhatsApp</span><span class="channel-name"><span class="channel-symbol" aria-hidden="true">◎</span> Instagram</span><span class="channel-name"><span class="channel-symbol" aria-hidden="true">f</span> Facebook</span></div><p class="channel-note">Integration access depends on configuration, permissions and provider approval.</p></div></div></section>
<section class="section section-soft"><div class="container problem-layout"><div><p class="eyebrow">A familiar kind of busy</p><h2>Your conversations grow.<br/>The confusion doesn’t have to.</h2><p class="lead">A customer question here. A follow-up there. Another teammate asking for context. Your business deserves a clearer picture.</p><a class="text-link" href={url('solutions/')}>Find your business use case <Icon size={17}/></a></div><div class="problem-list">{[['01','Scattered customer details','Give your team one place to review contacts and conversation history.'],['02','The same questions, again and again','Map common questions into a workflow, then test it with sample conversations.'],['03','Unclear next steps','Keep team assignments and access roles connected to the workspace.']].map(([n,title,text])=><div class="problem-item"><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div></div>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading-row"><div class="section-heading"><p class="eyebrow">Less juggling. More clarity.</p><h2>Practical tools.<br/>For everyday business.</h2></div><a class="text-link" href={url('features/')}>Explore all features <Icon size={17}/></a></div><div class="feature-grid">{features.map(f=><div class="feature-card"><div class="feature-top"><span class="feature-icon"><Icon name={f.icon}/></span><span class="feature-number">{f.number}</span></div><h3>{f.title}</h3><p>{f.text}</p></div>)}</div></div></section>
<section class="benefit-strip"><div class="container">{[['inbox','Context for the next reply','Keep the conversation connected to the customer.'],['flow','Room to think before you send','Test a workflow and review campaign previews.'],['team','A shared way of working','Give your team a clearer view of what comes next.']].map(([icon,title,text])=><div><Icon name={icon}/><h3>{title}</h3><p>{text}</p></div>)}</div></section>
<section class="section"><div class="container"><div class="section-heading center"><p class="eyebrow">From your day to your flow</p><h2>Start with one conversation.</h2><p>You don’t need to figure out everything at once.</p></div><div class="steps">{[['01','Tell us about your business','Show us where customer conversations get complicated and what you want to make simpler.'],['02','Explore the workspace','Walk through contacts, conversations and guided workflows. Discuss the integration requirements.'],['03','Try a thoughtful next step','Use sample conversations and campaign previews to review an approach before considering live use.']].map(([n,title,text])=><div><span class="step-number">{n}</span><h3>{title}</h3><p>{text}</p></div>)}</div><a class="text-link" href={url('how-it-works/')}>A closer look at the process <Icon size={17}/></a></div></section>
<section class="section section-soft"><div class="container"><div class="section-heading-row"><div class="section-heading"><p class="eyebrow">Your business. Your conversations.</p><h2>Different days.<br/>One need for clarity.</h2></div><a class="text-link" href={url('solutions/')}>Explore solutions <Icon size={17}/></a></div><div class="solution-grid">{[['01 / Retail','From “is it in stock?” to a helpful next step.','Organize product enquiries and explore responses to common questions.'],['02 / Services','Keep the details close to the conversation.','Review service enquiries and give the next teammate the context.'],['03 / Growing teams','A clearer handoff, as your team grows.','Keep contacts, team roles and conversation history in a shared workspace.']].map(([label,title,text])=><div class="solution-card"><span>{label}</span><h3>{title}</h3><p>{text}</p><a class="text-link" href={url('solutions/')}>See the possibilities <Icon size={16}/></a></div>)}</div></div></section>
<section class="section"><div class="container faq-layout"><div><p class="eyebrow">Good questions</p><h2>A little clarity,<br/>before we talk.</h2><p class="lead">Wondering if ValariFlow fits your business?</p><a class="text-link" href={url('contact-sales/')}>Talk to us <Icon size={17}/></a></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<CTA source="home"/>
</Layout>
