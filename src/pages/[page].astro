---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import LeadForm from '../components/LeadForm.astro';
import ProductPreview from '../components/ProductPreview.astro';
import { url, site, features, solutions } from '../data/site.mjs';
import legal from '../data/legal.json';
const pages = {
 'features': ['Features that bring your business into focus', 'Contacts, conversation history, guided workflows and team roles. Explore the tools and the current limits of ValariFlow.', 'The everyday essentials'],
 'solutions': ['Built around real business conversations', 'Explore conversation and workflow use cases for retail shops, service businesses and growing teams.', 'Find your fit'],
 'pricing': ['Start with what your business needs', 'Discuss ValariFlow pricing and business fit with our team. Public plans and prices have not been finalized.', 'A conversation before a commitment'],
 'how-it-works': ['A clearer path from question to next step', 'See how to explore the workspace, plan a guided workflow and test conversations before considering live use.', 'How it works'],
 'request-demo': ['See what a little more flow could look like', 'Request a ValariFlow demo. Explore contacts, conversations and guided workflow tools for your business.', 'Let’s take a look together'],
 'contact-sales': ['Your business has its own rhythm. Let’s talk.', 'Contact ValariFlow sales to discuss your team, messaging needs and product availability.', 'Contact sales'],
 'about': ['Good conversations deserve a little more clarity', 'ValariFlow is a business messaging and workflow product designed for small and medium businesses in India.', 'About ValariFlow'],
};
export function getStaticPaths() {
 return ['features','solutions','pricing','how-it-works','request-demo','contact-sales','about','privacy-policy','terms-of-service','data-deletion'].map(page => ({ params: { page } }));
}
const slug = Astro.params.page;
const legalPage = legal[slug];
const [title, description, eyebrow] = legalPage ? [legalPage[0], `${legalPage[0]} for ValariFlow.${site.legalApproved ? ' Information about our service and your data.' : ' Draft pending operator confirmation and legal review.'}`, 'Legal & trust'] : pages[slug];
---
<Layout title={title} description={description} path={`${slug}/`}>
<PageHero eyebrow={eyebrow} title={title} text={legalPage ? 'Clear information about the service, your data and the decisions awaiting operator confirmation.' : description}/>
{slug === 'features' && <>
 <section class="section"><div class="container"><div class="feature-grid">{features.map(f=><div class="feature-card"><div class="feature-top"><span class="feature-icon"><Icon name={f.icon}/></span><span class="feature-number">{f.number}</span></div><h2 class="feature-title">{f.title}</h2><p>{f.text}</p></div>)}</div><div class="status-note feature-status"><strong>Know what you’re exploring.</strong> Workspace tools and preview workflows are implemented. Live integration access depends on configuration, permissions and provider approval. Broadcasts remain preview-only. No public production launch, Meta approval or guaranteed delivery is claimed.</div></div></section>
 <section class="section section-soft"><div class="container split"><div><p class="eyebrow">The bigger picture</p><h2>A workspace with context.</h2><p class="lead">Contacts, conversations and workflows are easier to reason about when the pieces sit together.</p><ul class="check-list"><li><Icon name="check" size={18}/>Workspace-scoped contact and message records</li><li><Icon name="check" size={18}/>Roles for business admins, users and agents</li><li><Icon name="check" size={18}/>Draft workflow versions and conversation tests</li></ul></div><ProductPreview/></div></section><CTA source="features"/>
 </>}
{slug === 'solutions' && <><section class="section"><div class="container">{solutions.map((s,i)=><div class="solution-detail"><div><p class="eyebrow">0{i+1} / {s.eyebrow}</p><h2>{s.title}</h2><a class="text-link" href={url('request-demo/')} data-conversion={`solution-${i+1}-demo`}>Explore your use case <Icon size={17}/></a></div><div><p>{s.text}</p><div class="tags">{s.examples.map(e=><span>{e}</span>)}</div></div></div>)}<div class="status-note feature-status">These are suggested ways to explore the product, not customer testimonials or promises of a business outcome. Live messaging and integrations require separate verification.</div></div></section><CTA source="solutions"/></>}
{slug === 'pricing' && <><section class="section"><div class="container split"><div class="price-card"><span class="pill">Let’s find the right fit</span><h2>Built around your needs.</h2><p class="price-text">Talk to us about pricing</p><p>Public plans and prices are awaiting confirmation. Start with your team, conversation needs and the capabilities you want to explore.</p><ul class="check-list"><li><Icon name="check" size={18}/>Discuss your business and workspace</li><li><Icon name="check" size={18}/>Review product availability and limitations</li><li><Icon name="check" size={18}/>Ask about plan and credit terms</li></ul><a class="button" href={url('contact-sales/')} data-conversion="pricing-contact">Contact sales <Icon size={18}/></a><p class="form-note">No payment or purchase on this website.</p></div><div class="pricing-details"><div><h2>A few things to know.</h2><p>A clear understanding before any commercial commitment.</p></div><div><h3>Workspace credits are separate from Meta charges.</h3><p>The product records subscriptions and internal credit transactions. Credits do not grant provider permissions or replace Meta fees.</p></div><div><h3>Campaign previews do not send messages.</h3><p>Current broadcast previews do not charge credits. They do not demonstrate live bulk delivery.</p></div><div><h3>Ask for the confirmed commercial terms.</h3><p>Prices, taxes, renewals, cancellation, refunds and unused-credit policies need operator confirmation before purchase. No automatic refund or renewal is promised here.</p></div></div></div></section><CTA source="pricing" title="Let’s talk about what fits."/></>}
{slug === 'how-it-works' && <><section class="section"><div class="container"><div class="steps">{[['01','Start with your day','Tell us how your team handles enquiries and where the context gets lost. A demo begins with your business needs.'],['02','Explore your workspace','Review contacts, conversation history and team roles. Discuss which Meta assets and permissions would be required.'],['03','Build, test, then review','Map a common question into a guided draft. Test with sample conversations and review current product limits before any live rollout.']].map(([n,h,p])=><div><span class="step-number">{n}</span><h2 class="step-title">{h}</h2><p>{p}</p></div>)}</div></div></section><section class="section section-soft"><div class="container split"><div><p class="eyebrow">An example, not a promise</p><h2>Plan a helpful welcome.</h2><p class="lead">Start with a greeting. Offer a choice. Decide when a person should take over.</p><div class="workflow" aria-label="Example draft workflow"><span>Welcome</span><b aria-hidden="true">→</b><span>Common question</span><b aria-hidden="true">→</b><span>Team handoff</span></div><p class="form-note">Conceptual workflow. Live execution depends on supported steps, configuration and provider permission.</p></div><div class="content-panel"><h2>Before you consider live use</h2><ul class="check-list"><li><Icon name="check" size={18}/>Confirm integration eligibility and permissions.</li><li><Icon name="check" size={18}/>Review contact consent and opt-out handling.</li><li><Icon name="check" size={18}/>Test the experience with sample data.</li><li><Icon name="check" size={18}/>Confirm security, privacy and commercial terms.</li></ul><p>Connecting an account or publishing a website does not itself authorize customer onboarding or live messaging.</p></div></div></section><CTA source="how-it-works"/></>}
{(slug === 'request-demo' || slug === 'contact-sales') && <section class="section section-soft"><div class="container split"><aside class="contact-aside"><p class="eyebrow">A conversation, not a checkout</p><h2>{slug === 'request-demo' ? 'Make the demo about your day.' : 'Start with the questions that matter.'}</h2><p>Tell us a little about your business and the conversations you want to organize. We’ll use your email to discuss your enquiry.</p>{[['inbox','Your business, in context','What your team handles now and what you want to make clearer.'],['flow','An honest look at the product','Explore the tools, preview features and integration requirements.'],['mail','An email you control','Review the draft before sending. No lead data is saved on this site.']].map(([icon,h,p])=><div class="contact-point"><span class="feature-icon"><Icon name={icon}/></span><div><h3>{h}</h3><p>{p}</p></div></div>)}<div class="status-note">Do not send customer lists, private messages, passwords or Meta access tokens. Demo scheduling and availability will be agreed by email; no instant booking is promised.</div></aside><LeadForm kind={slug === 'request-demo' ? 'demo' : 'sales'}/></div></section>}
{slug === 'about' && <><section class="section"><div class="container"><p class="about-statement">Running a small business already asks a lot of you. <em>Keeping track of customer conversations shouldn’t add to the noise.</em></p><div class="split about-body"><p class="lead">ValariFlow is designed for business owners who want a clearer way to organize contacts, conversations and the steps in between. Our focus is Indian SMBs, including retail shops and service businesses.</p><div><p>We’re building around practical questions: What did the customer ask? Who can help? What should happen next?</p><p>That means guided tools, understandable screens and honest descriptions of what is ready, what is a preview and what needs further approval.</p><a class="text-link" href={url('contact-sales/')}>Tell us about your business <Icon size={17}/></a></div></div></div></section><section class="section section-soft"><div class="container"><div class="section-heading"><p class="eyebrow">What guides the product</p><h2>Keep it useful. Keep it clear.</h2></div><div class="value-grid"><div><h3>Start with the business.</h3><p>Tools should make sense to the people doing the work, including owners who don’t think of themselves as technical.</p></div><div><h3>Respect the conversation.</h3><p>Contacts and messages carry trust. Permission, access roles and thoughtful workflows belong in the discussion.</p></div><div><h3>Be clear about readiness.</h3><p>A preview is a preview. An integration needs permission. A good product conversation makes those limits visible.</p></div></div><div class="status-note feature-status">Legal operator: {site.operator}. Public contact: <a href={`mailto:${site.email}`}>{site.email}</a>. Operator identity and formal business information remain pending confirmation before publication.</div></div></section><CTA source="about"/></>}
{legalPage && <section class="section"><div class="container article-wrap"><div class="legal-intro">{!site.legalApproved && <><strong>Draft for operator review — not effective.</strong> Unconfirmed information is marked [CONFIRM]. A confirmed contact address does not establish a verified deletion process. </>}Effective date: {site.effectiveDate}. Contact: <a href={`mailto:${site.email}`}>{site.email}</a>.</div><nav class="legal-toc" aria-label="On this page"><strong>On this page</strong><ol>{legalPage[1].map(([h],i)=><li><a href={`#section-${i+1}`}>{h}</a></li>)}</ol></nav><div class="prose">{legalPage[1].map(([h,p],i)=><section aria-labelledby={`section-${i+1}`}><h2 id={`section-${i+1}`}>{h}</h2><p>{p}</p></section>)}</div></div></section>}
</Layout>
